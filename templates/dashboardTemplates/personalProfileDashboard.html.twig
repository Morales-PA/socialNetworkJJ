{% extends "parentTemplate.html.twig" %}

{% block header %}  
        <h1> {{ userName }} </h1> 
        <h3> {{ userEmail }} </h3>
        <a href="{{ path("logout") }}">Cerrar Sesión</a> <br> 
{% endblock %} 

{% block flashMessagesLooper %} 
        {{ parent() }}
{% endblock %} 

{% block content %} 

        <h4> Tus posts: </h4>
        
        {% if userPostsArray is not empty %}

                {% for post in userPostsArray  %}

                        <p class="container"> {{ post.fechaPublicacion|date('d/m/Y H:i') }} | {{ post.contenido }} | <a href="{{ path("comments_displayer", { "postId" : post.idPost }) }}">Ver comentarios </a>  </p>
                        
                {% endfor %}

        {% endif %}

{% endblock %} 

{% block footer %}
        {{ parent() }}
{% endblock %} 